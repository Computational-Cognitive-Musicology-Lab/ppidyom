# Minimal IDyOM environment for ppidyom validation tests.
# Installs: SBCL, Quicklisp, IDyOM (Common Lisp), Python 3 + pandas.
# No JupyterLab; designed to run generate_idyom_reference.py non-interactively.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    sbcl \
    sqlite3 \
    libsqlite3-dev \
    wget \
    unzip \
    python3 \
    python3-pip \
 && rm -rf /var/lib/apt/lists/*

# ── Quicklisp ─────────────────────────────────────────────────────────────────
RUN wget -q https://beta.quicklisp.org/quicklisp.lisp -O /tmp/quicklisp.lisp \
 && sbcl --noinform \
         --load /tmp/quicklisp.lisp \
         --eval '(quicklisp-quickstart:install :path "/root/quicklisp/")' \
         --eval '(quit)' \
 && rm /tmp/quicklisp.lisp

# ── IDyOM ─────────────────────────────────────────────────────────────────────
RUN wget -q https://github.com/mtpearce/idyom/archive/refs/heads/master.zip \
         -O /tmp/idyom.zip \
 && unzip -q /tmp/idyom.zip -d /root/quicklisp/local-projects/ \
 && mv /root/quicklisp/local-projects/idyom-master \
       /root/quicklisp/local-projects/idyom \
 && rm /tmp/idyom.zip

# Runtime directories that IDyOM expects to exist
RUN mkdir -p \
    /root/idyom/db \
    /root/idyom/data/cache \
    /root/idyom/data/models \
    /root/idyom/data/resampling

# Pre-compile IDyOM, create the SQLite database, and initialise the schema.
# *idyom-root* must be set before loading IDyOM so it can locate its data dirs.
RUN sbcl --noinform \
         --eval '(load "/root/quicklisp/setup.lisp")' \
         --eval '(ql:quickload "clsql" :silent t)' \
         --eval '(defvar *idyom-root* "/root/idyom/")' \
         --eval '(ql:quickload "idyom"  :silent t)' \
         --eval '(clsql:connect (list "/root/idyom/db/database.sqlite") :if-exists :old :database-type :sqlite3)' \
         --eval '(idyom-db:initialise-database)' \
         --eval '(quit)'

# SBCL startup file — defines (start-idyom) used at the top of every
# compute.lisp script generated by generate_idyom_reference.py.
# NOTE: idyom-db:initialise-database is NOT called here because the
# idyom-db package does not exist when .sbclrc is read (before IDyOM loads).
# The database schema is initialised once during the Docker build above.
# Each "docker run" starts from the image's clean database state.
RUN printf '%s\n' \
    '(load "/root/quicklisp/setup.lisp")' \
    '(ql:quickload "clsql" :silent t)' \
    '(defun start-idyom ()' \
    '  (defvar *idyom-root* "/root/idyom/")' \
    '  (defvar *idyom-message-detail-level* 1)' \
    '  (ql:quickload "idyom" :silent t)' \
    '  (clsql:connect (list "/root/idyom/db/database.sqlite")' \
    '                 :if-exists :old :database-type :sqlite3))' \
    > /root/.sbclrc

# ── Python ────────────────────────────────────────────────────────────────────
RUN pip3 install --quiet pandas

WORKDIR /work
